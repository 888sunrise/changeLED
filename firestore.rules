rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /test/connection {
      allow read: if true;
    }

    match /hearing_records/{recordId} {
      allow read: if isValidId(recordId);
      allow create: if isValidId(recordId);
      allow update: if isValidId(recordId);
      allow delete: if isValidId(recordId);
    }

    match /stores_led_records/{storeId} {
      allow read: if isValidId(storeId);
      allow create: if isValidId(storeId);
      allow update: if isValidId(storeId);
      allow delete: if isValidId(storeId);
    }
  }
}
